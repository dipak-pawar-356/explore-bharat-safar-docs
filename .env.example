# Core Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Persistence (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/explore_bharat_safar?schema=public

# Caching & Distributed Locks (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_dev_redis_secret_password_16chars

# Identity & Cryptography (RS256 JWT & Argon2id)
