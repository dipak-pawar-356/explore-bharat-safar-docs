# Explore Bharat Safar — Production Environment Template
# Reference: EBS-DOC-28-ENV & EBS-BLU-45-INFRA

# Platform & Server
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_URL=https://explorebharatsafar.in
API_URL=https://api.explorebharatsafar.in
CORS_ORIGIN=https://explorebharatsafar.in,https://admin.explorebharatsafar.in

# PostgreSQL 16 Multi-AZ + PostGIS Database
# Connected through PgBouncer connection pooler
DATABASE_URL=postgresql://ebs_user:REPLACE_WITH_STRONG_PASSWORD@pgbouncer.ebs-production.svc.cluster.local:5432/ebs_production?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Redis 7 Multi-AZ Cluster (Cache, Redlock, BullMQ)
REDIS_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@redis-cluster.ebs-production.svc.cluster.local:6379

# Cryptography & JWT Key Rotation (256-bit entropy)
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRY=900s
JWT_REFRESH_EXPIRY=604800s
COOKIE_SECRET=REPLACE_WITH_64_CHAR_COOKIE_SIGNING_SECRET

# HashiCorp Vault / External Secrets
VAULT_ADDR=https://vault.internal.explorebharatsafar.in:8200
VAULT_ROLE=ebs-workload-role
VAULT_SECRETS_PATH=/vault/secrets

# AWS Sovereign S3 Object Storage (Media, GIS TopoJSON, Backups)
AWS_REGION=ap-south-1
AWS_S3_MEDIA_BUCKET=ebs-production-media-vault
AWS_S3_BACKUP_BUCKET=ebs-production-cold-backups

# Payment Gateway (Razorpay Production Mode)
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Communications & SMS/Email Gateways
AWS_SES_REGION=ap-south-1
GUPSHUP_API_KEY=REPLACE_WITH_GUPSHUP_PRODUCTION_KEY
WHATSAPP_BUSINESS_TOKEN=REPLACE_WITH_META_WHATSAPP_TOKEN

# Observability & Monitoring
LOG_LEVEL=info
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.ebs-monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=ebs-api-production
