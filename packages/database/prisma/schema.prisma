model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @db.VarChar(100)
  category        String    @db.VarChar(50)
  priority        String    @default("NORMAL") @db.VarChar(20)
  title           String    @db.VarChar(255)
  body            String    @db.Text
  richContent     Json?     @map("rich_content")
  actionUrl       String?   @map("action_url") @db.VarChar(500)
  metadata        Json?
  channels        String[]  @default(["IN_APP"]) @db.VarChar(50)
  deliveryStatus  String    @default("PENDING") @map("delivery_status") @db.VarChar(30)
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at") @db.Timestamptz()
  isArchived      Boolean   @default(false) @map("is_archived")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs    NotificationDeliveryLog[]

  @@index([userId, isRead], name: "idx_notifications_user_read")
  @@index([userId, isArchived], name: "idx_notifications_user_archived")
  @@index([category], name: "idx_notifications_category")
  @@index([priority], name: "idx_notifications_priority")
  @@index([createdAt], name: "idx_notifications_created_at")
  @@map("notifications")
  @@schema("notification_schema")
}

model NotificationPreference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  channelInApp    Boolean  @default(true) @map("channel_in_app")
  channelEmail    Boolean  @default(true) @map("channel_email")
  channelSms      Boolean  @default(true) @map("channel_sms")
  channelWhatsApp Boolean  @default(true) @map("channel_whatsapp")
  channelWebPush  Boolean  @default(false) @map("channel_web_push")

  catTransactional Boolean @default(true) @map("cat_transactional")
  catSecurity     Boolean  @default(true) @map("cat_security")
  catBooking      Boolean  @default(true) @map("cat_booking")
  catPayment      Boolean  @default(true) @map("cat_payment")
  catVillage      Boolean  @default(true) @map("cat_village")
  catSocial       Boolean  @default(true) @map("cat_social")
  catCommunity    Boolean  @default(true) @map("cat_community")
  catMarketing    Boolean  @default(false) @map("cat_marketing")

  quietHoursEnabled Boolean @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String? @default("22:00") @map("quiet_hours_start") @db.VarChar(10)
  quietHoursEnd     String? @default("07:00") @map("quiet_hours_end") @db.VarChar(10)
  timezone          String  @default("Asia/Kolkata") @db.VarChar(100)

  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
  @@schema("notification_schema")
