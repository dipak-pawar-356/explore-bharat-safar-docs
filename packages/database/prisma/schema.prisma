model NotificationTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @db.VarChar(100)
  version       String   @default("1.0.0") @db.VarChar(20)
  category      String   @db.VarChar(50)
  channel       String   @db.VarChar(30)
  titleTemplate String   @map("title_template") @db.VarChar(300)
  bodyTemplate  String   @map("body_template") @db.Text
  variables     String[] @default([]) @db.VarChar(100)
  locale        String   @default("en") @db.VarChar(10)
  isActive      Boolean  @default(true) @map("is_active")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([slug, version, locale, channel])
  @@index([category], name: "idx_templates_category")
  @@index([slug], name: "idx_templates_slug")
  @@map("notification_templates")
  @@schema("notification_schema")
}

model NotificationDeliveryLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String    @map("notification_id") @db.Uuid
  channel           String    @db.VarChar(30)
  provider          String    @db.VarChar(50)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(255)
  status            String    @default("SENT") @db.VarChar(30)
  attempts          Int       @default(1)
  responseTimeMs    Int       @default(0) @map("response_time_ms")
  errorDetails      String?   @map("error_details") @db.Text
  dispatchedAt      DateTime  @default(now()) @map("dispatched_at") @db.Timestamptz()
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz()

  // Relations
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId], name: "idx_delivery_logs_notif")
  @@index([status], name: "idx_delivery_logs_status")
  @@index([provider], name: "idx_delivery_logs_provider")
  @@map("notification_delivery_logs")
  @@schema("notification_schema")
}

model NotificationDeadLetter {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId          String    @map("job_id") @db.VarChar(255)
  queueName      String    @map("queue_name") @db.VarChar(100)
  notificationId String?   @map("notification_id") @db.VarChar(255)
  payload        Json
  failureReason  String    @map("failure_reason") @db.Text
  stackTrace     String?   @map("stack_trace") @db.Text
  retryCount     Int       @default(3) @map("retry_count")
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at") @db.Timestamptz()
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz()
  resolvedBy     String?   @map("resolved_by") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([queueName], name: "idx_dlq_queue")
  @@index([resolvedAt], name: "idx_dlq_resolved")
  @@map("notification_dead_letters")
  @@schema("notification_schema")
}

model NotificationDeviceToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique @db.VarChar(1000)
  p256dh     String    @db.VarChar(255)
  auth       String    @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_device_tokens_user")
  @@map("notification_device_tokens")
  @@schema("notification_schema")
}

