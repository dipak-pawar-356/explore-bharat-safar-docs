model Certificate {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateNumber    String             @unique @map("certificate_number") @db.VarChar(50)
  participantId        String             @unique @map("participant_id") @db.Uuid
  bookingId            String             @map("booking_id") @db.Uuid
  batchId              String?            @map("batch_id") @db.Uuid
  userId               String?            @map("user_id") @db.Uuid
  participantName      String             @map("participant_name") @db.VarChar(150)
  experienceTitle      String             @map("experience_title") @db.VarChar(255)
  experienceLocation   String?            @map("experience_location") @db.VarChar(255)
  highestAltitudeMeters Int?              @map("highest_altitude_meters")
  completionDate       DateTime           @map("completion_date") @db.Date
  verificationHash     String             @map("verification_hash") @db.VarChar(64)
  digitalSignature     String?            @map("digital_signature") @db.Text
  qrVerificationUrl    String?            @map("qr_verification_url") @db.VarChar(512)
  pdfVaultUri          String             @map("pdf_vault_uri") @db.VarChar(512)
  imageVaultUri        String?            @map("image_vault_uri") @db.VarChar(512)
  status               String             @default("ISSUED") @map("status") @db.VarChar(20)
  reissueCount         Int                @default(0) @map("reissue_count")
  revokedAt            DateTime?          @map("revoked_at") @db.Timestamptz()
  revokedReason        String?            @map("revoked_reason") @db.VarChar(500)
  revokedBy            String?            @map("revoked_by") @db.Uuid
  issuedAt             DateTime           @default(now()) @map("issued_at") @db.Timestamptz()
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  participant          BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  booking              Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  auditLogs            CertificateAuditLog[]

  @@index([certificateNumber], name: "idx_certs_number")
  @@index([bookingId], name: "idx_certs_booking")
  @@index([batchId], name: "idx_certs_batch")
  @@index([userId], name: "idx_certs_user")
  @@map("certificates")
  @@schema("certificate_schema")
}

model CertificateAuditLog {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId        String             @map("certificate_id") @db.Uuid
  certificateNumber    String             @map("certificate_number") @db.VarChar(50)
  action               String             @map("action") @db.VarChar(50)
  actorId              String             @map("actor_id") @db.Uuid
  actorRole            String             @map("actor_role") @db.VarChar(50)
  details              Json               @map("details")
  ipAddress            String?            @map("ip_address") @db.VarChar(45)
  timestamp            DateTime           @default(now()) @map("timestamp") @db.Timestamptz()

  certificate          Certificate        @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId], name: "idx_cert_audit_cert_id")
  @@index([certificateNumber], name: "idx_cert_audit_cert_num")
  @@map("certificate_audit_logs")
  @@schema("certificate_schema")
}

