model TravellerProfile {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String             @unique @map("user_id") @db.Uuid
  username                 String             @unique @db.VarChar(50)
  displayName              String             @map("display_name") @db.VarChar(100)
  bio                      String?
  avatarUrl                String?            @map("avatar_url")
  coverImageUrl            String?            @map("cover_image_url")
  homeState                String?            @map("home_state") @db.VarChar(100)
  homeCity                 String?            @map("home_city") @db.VarChar(100)
  spokenLanguages          String[]           @default([]) @map("spoken_languages")
  adventureGrade           String             @default("EXPLORER") @map("adventure_grade") @db.VarChar(50)
  visitedStatesCount       Int                @default(0) @map("visited_states_count")
  visitedDistrictsCount    Int                @default(0) @map("visited_districts_count")
  completedExpeditionsCount Int               @default(0) @map("completed_expeditions_count")
  totalElevationMeters     Int                @default(0) @map("total_elevation_meters")
  followersCount           Int                @default(0) @map("followers_count")
  followingCount           Int                @default(0) @map("following_count")
  isProfilePublic          Boolean            @default(true) @map("is_profile_public")
  isSoloDiscoveryEnabled   Boolean            @default(false) @map("is_solo_discovery_enabled")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                    Post[]
  stories                  TemporaryStory[]
  sentFollows              Follow[]           @relation("Follower")
  receivedFollows          Follow[]           @relation("Following")
  sentFollowRequests       FollowRequest[]    @relation("Requester")
  receivedFollowRequests   FollowRequest[]    @relation("Target")
  blockedUsers             UserBlock[]        @relation("Blocker")
  blockedByUsers           UserBlock[]        @relation("Blocked")
  mutedUsers               UserMute[]         @relation("Muter")
  createdCommunities       Community[]        @relation("CommunityCreator")
  communityMemberships     CommunityMember[]
  mediaAttachments         MediaAttachment[]

  @@map("traveller_profiles")
  @@schema("social_schema")
}

model Post {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String           @map("profile_id") @db.Uuid
  postType      String           @map("post_type") @db.VarChar(50)
  title         String?          @db.VarChar(255)
  content       String
  mediaUris     String[]         @default([]) @map("media_uris")
  hashtags      String[]         @default([])
  mentions      String[]         @default([])
  placeId       String?          @map("place_id") @db.Uuid
  villageId     String?          @map("village_id") @db.Uuid
  locationName  String?          @map("location_name") @db.VarChar(150)
  visibility    String           @default("PUBLIC") @db.VarChar(50)
  reactionCount Int              @default(0) @map("reaction_count")
  commentCount  Int              @default(0) @map("comment_count")
  status        String           @default("PUBLISHED") @db.VarChar(50)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz()

  profile       TravellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], name: "idx_posts_profile")
  @@index([visibility], name: "idx_posts_visibility")
  @@index([status], name: "idx_posts_status")
  @@map("posts")
  @@schema("social_schema")
}

model TemporaryStory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  mediaUri    String           @map("media_uri") @db.VarChar(512)
  caption     String?          @db.VarChar(255)
  publishedAt DateTime         @default(now()) @map("published_at") @db.Timestamptz()
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz()
  status      String           @default("ACTIVE") @db.VarChar(50)

  profile     TravellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt], name: "idx_stories_active")
  @@map("temporary_stories")
  @@schema("social_schema")
}

model Follow {
  followerId  String           @map("follower_id") @db.Uuid
  followingId String           @map("following_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  follower    TravellerProfile @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   TravellerProfile @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("followers")
  @@schema("social_schema")
}

model FollowRequest {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  targetId    String           @map("target_id") @db.Uuid
  status      String           @default("PENDING") @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  requester   TravellerProfile @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      TravellerProfile @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@map("follow_requests")
  @@schema("social_schema")
}

model UserBlock {
  blockerId String           @map("blocker_id") @db.Uuid
  blockedId String           @map("blocked_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  blocker   TravellerProfile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   TravellerProfile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
  @@schema("social_schema")
}

model UserMute {
  muterId   String           @map("muter_id") @db.Uuid
  mutedId   String           @map("muted_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  muter     TravellerProfile @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@map("user_mutes")
  @@schema("social_schema")
}

model Community {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String            @unique @db.VarChar(100)
  title            String            @db.VarChar(150)
