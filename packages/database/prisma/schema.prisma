// Explore Bharat Safar — Enterprise Relational & Spatial Database Schema
// Conforms to EBS-DOC-10-DATA & EBS-DOC-03-ARCH

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity_schema", "geo_spatial_schema", "rural_bharat_schema", "booking_schema", "payment_schema", "certificate_schema", "social_schema", "audit_schema", "admin_schema", "notification_schema"]
}

// ==========================================
// 1. IDENTITY & IAM SCHEMA
// ==========================================

model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String     @unique @db.VarChar(255)
  passwordHash         String     @map("password_hash") @db.VarChar(255)
  phoneNumber          String?    @unique @map("phone_number") @db.VarChar(20)
  emailVerifiedAt      DateTime?  @map("email_verified_at") @db.Timestamptz()
  phoneVerifiedAt      DateTime?  @map("phone_verified_at") @db.Timestamptz()
  status               String     @default("ACTIVE") @db.VarChar(50)
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz()
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz()

  // Relations
  userRoles            UserRole[]
  refreshTokens        RefreshToken[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  auditLogs            AuditLog[]
  bookings             Booking[]
  profile              TravellerProfile?
  assignedVillages     Village[]          @relation("VillageAdmin")
  submittedUpdates     VillageUpdateStaging[] @relation("SubmittedUpdates")
  reviewedUpdates      VillageUpdateStaging[] @relation("ReviewedUpdates")
  notifications        Notification[]
  notificationPref     NotificationPreference?
  deviceTokens         NotificationDeviceToken[]

  @@index([email], name: "idx_users_email_active")
  @@index([phoneNumber], name: "idx_users_phone")
  @@map("users")
  @@schema("identity_schema")
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  userRoles   UserRole[]

  @@map("roles")
  @@schema("identity_schema")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity_schema")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  token             String    @unique @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz()
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(255)
  replacedByToken   String?   @map("replaced_by_token") @db.VarChar(255)
  familyId          String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user")
  @@index([token], name: "idx_refresh_tokens_token")
  @@map("refresh_tokens")
  @@schema("identity_schema")
}

model EmailVerification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
  @@schema("identity_schema")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
  @@schema("identity_schema")
}

// ==========================================
// 2. GEO-SPATIAL SCHEMA (BHARAT DISCOVERY ENGINE)
// ==========================================

model State {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String     @unique @db.VarChar(100)
  isoCode           String     @unique @map("iso_code") @db.VarChar(10)
  capital           String     @db.VarChar(100)
  officialLanguages String[]   @map("official_languages")
  overviewDossier   Json       @map("overview_dossier")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz()

  districts         District[]

  @@map("states")
  @@schema("geo_spatial_schema")
}

model District {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateId            String     @map("state_id") @db.Uuid
  name               String     @db.VarChar(100)
  headquarters       String     @db.VarChar(100)
  emergencyDirectory Json       @map("emergency_directory")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz()

  state              State      @relation(fields: [stateId], references: [id], onDelete: Restrict)
  talukas            Taluka[]

  @@unique([stateId, name], name: "uq_state_district")
  @@map("districts")
  @@schema("geo_spatial_schema")
}

model Taluka {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  districtId String     @map("district_id") @db.Uuid
  name       String     @db.VarChar(100)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz()

  district   District   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  places     Place[]
  villages   Village[]

  @@unique([districtId, name], name: "uq_district_taluka")
  @@map("talukas")
  @@schema("geo_spatial_schema")
}

model Category {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String     @unique @db.VarChar(100)
  name       String     @db.VarChar(100)
  iconToken  String     @map("icon_token") @db.VarChar(50)
  parentId   String?    @map("parent_id") @db.Uuid

  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")

  @@map("categories")
  @@schema("geo_spatial_schema")
}

model Place {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  talukaId           String       @map("taluka_id") @db.Uuid
  name               String       @db.VarChar(255)
  slug               String       @unique @db.VarChar(255)
  categoryIds        String[]     @map("category_ids") @db.Uuid
  elevationMeters    Int?         @map("elevation_meters")
  historicalOverview String       @map("historical_overview")
  architectureNotes  String?      @map("architecture_notes")
  operatingHours     Json?        @map("operating_hours")
  entryTariffs       Json?        @map("entry_tariffs")
  isBookingEnabled   Boolean      @default(false) @map("is_booking_enabled")
  linkedExperienceId String?      @map("linked_experience_id") @db.Uuid
  averageRating      Decimal      @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  reviewCount        Int          @default(0) @map("review_count")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz()

  taluka             Taluka       @relation(fields: [talukaId], references: [id], onDelete: Restrict)
  landmark3D         Landmark3D?
  experiences        Experience[]

  @@index([talukaId], name: "idx_places_taluka")
  @@map("places")
  @@schema("geo_spatial_schema")
}

model Landmark3D {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId          String   @unique @map("place_id") @db.Uuid
  name             String   @db.VarChar(100)
  modelAssetUri    String   @map("model_asset_uri") @db.VarChar(512)
  renderScale      Decimal  @default(1.00) @map("render_scale") @db.Decimal(4, 2)
  boundingRadiusPx Int      @default(48) @map("bounding_radius_px")

  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("landmarks_3d")
  @@schema("geo_spatial_schema")
}

// ==========================================
// 3. RURAL BHARAT SCHEMA (VILLAGE KNOWLEDGE SYSTEM)
// ==========================================

model Village {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  talukaId             String                 @map("taluka_id") @db.Uuid
  lgdCode              String                 @unique @map("lgd_code") @db.VarChar(20)
  nameEn               String                 @map("name_en") @db.VarChar(150)
  nameLocal            String                 @map("name_local") @db.VarChar(150)
  pincode              String                 @db.VarChar(10)
  populationCount      Int?                   @default(0) @map("population_count")
  elevationMeters      Int?                   @map("elevation_meters")
  historicalChronicles String?                @map("historical_chronicles")
  etymologyMeaning     String?                @map("etymology_meaning")
  approvalStatus       String                 @default("PUBLISHED") @map("approval_status") @db.VarChar(50)
  assignedAdminUserId  String?                @map("assigned_admin_user_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz()

  taluka               Taluka                 @relation(fields: [talukaId], references: [id], onDelete: Restrict)
  assignedAdmin        User?                  @relation("VillageAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  panchayat            VillagePanchayat?
  stagingUpdates       VillageUpdateStaging[]

  @@index([pincode], name: "idx_villages_pincode")
  @@index([talukaId], name: "idx_villages_taluka")
  @@map("villages")
  @@schema("rural_bharat_schema")
}

model VillagePanchayat {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  villageId          String   @unique @map("village_id") @db.Uuid
  gramPanchayatName  String   @map("gram_panchayat_name") @db.VarChar(150)
  gramSevakName      String?  @map("gram_sevak_name") @db.VarChar(150)
  officePhone        String?  @map("office_phone") @db.VarChar(50)
  officeAddress      String?  @map("office_address")
  officeTimings      String?  @map("office_timings") @db.VarChar(100)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  village            Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@map("village_panchayats")
  @@schema("rural_bharat_schema")
}

model VillageUpdateStaging {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  villageId      String    @map("village_id") @db.Uuid
  submittedBy    String    @map("submitted_by") @db.Uuid
  updateType     String    @map("update_type") @db.VarChar(100)
  payload        Json
  status         String    @default("PENDING_APPROVAL") @db.VarChar(50)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewComments String?   @map("review_comments")
  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.Timestamptz()
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz()

  village        Village   @relation(fields: [villageId], references: [id], onDelete: Cascade)
  submitter      User      @relation("SubmittedUpdates", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("ReviewedUpdates", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status], name: "idx_village_staging_pending")
  @@map("village_updates_staging")
  @@schema("rural_bharat_schema")
}

// ==========================================
// 4. BOOKING & EXPERIENCES SCHEMA
// ==========================================

model Experience {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId                     String?   @map("place_id") @db.Uuid
  title                       String    @db.VarChar(255)
  slug                        String    @unique @db.VarChar(255)
  experienceType              String    @map("experience_type") @db.VarChar(50)
  difficultyLevel             String    @map("difficulty_level") @db.VarChar(50)
  maxAltitudeMeters           Int?      @map("max_altitude_meters")
  basePrice                   Decimal   @map("base_price") @db.Decimal(10, 2)
  mandatoryUpfrontPercentage  Int       @default(25) @map("mandatory_upfront_percentage")
  inclusions                  String[]
  exclusions                  String[]
  itineraryDaywise            Json      @map("itinerary_daywise")
  isActive                    Boolean   @default(true) @map("is_active")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz()

  place                       Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  batches                     Batch[]

  @@map("experiences")
  @@schema("booking_schema")
}

model Batch {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId   String     @map("experience_id") @db.Uuid
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime   @map("end_date") @db.Date
  totalCapacity  Int        @map("total_capacity")
  availableSlots Int        @map("available_slots")
  batchStatus    String     @default("OPEN") @map("batch_status") @db.VarChar(50)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  experience     Experience @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  bookings       Booking[]

  @@index([experienceId, startDate], name: "idx_batches_exp_date")
  @@map("batches")
  @@schema("booking_schema")
}

model Booking {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingNumber      String               @unique @map("booking_number") @db.VarChar(50)
  userId             String               @map("user_id") @db.Uuid
  batchId            String               @map("batch_id") @db.Uuid
  totalAmount        Decimal              @map("total_amount") @db.Decimal(10, 2)
  advanceAmountPaid  Decimal              @default(0.00) @map("advance_amount_paid") @db.Decimal(10, 2)
  balanceAmountDue   Decimal              @map("balance_amount_due") @db.Decimal(10, 2)
  bookingStatus      String               @default("PENDING_PAYMENT") @map("booking_status") @db.VarChar(50)
  termsVersion       String               @map("terms_version") @db.VarChar(20)
  termsAcceptedAt    DateTime             @map("terms_accepted_at") @db.Timestamptz()
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  batch              Batch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  participants       BookingParticipant[]
  payments           PaymentTransaction[]
  invoices           Invoice[]
  certificates       Certificate[]
  paymentIntents     PaymentIntent[]
  refundRecords      RefundRecord[]
  ledgerEntries      TransactionLedgerEntry[]

  @@index([userId], name: "idx_bookings_user")
  @@index([bookingStatus], name: "idx_bookings_status")
  @@map("bookings")
  @@schema("booking_schema")
}

model BookingParticipant {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId            String       @map("booking_id") @db.Uuid
  fullName             String       @map("full_name") @db.VarChar(150)
  age                  Int
  gender               String       @db.VarChar(20)
  emergencyPhone       String       @map("emergency_phone") @db.VarChar(20)
  medicalNotes         String?      @map("medical_notes")
  isAttendanceVerified Boolean      @default(false) @map("is_attendance_verified")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  booking              Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  certificate          Certificate?

  @@map("booking_participants")
  @@schema("booking_schema")
}

// ==========================================
// 5. FINTECH & PAYMENT SCHEMA
// ==========================================

model PaymentTransaction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String                   @map("booking_id") @db.Uuid
  gatewayReference  String                   @unique @map("gateway_reference") @db.VarChar(255)
  paymentMethod     String                   @map("payment_method") @db.VarChar(50)
  amountPaid        Decimal                  @map("amount_paid") @db.Decimal(10, 2)
  transactionType   String                   @map("transaction_type") @db.VarChar(50)
  transactionStatus String                   @map("transaction_status") @db.VarChar(50)
  gatewayPayload    Json                     @map("gateway_payload")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz()

  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds           RefundRecord[]
  ledgerEntries     TransactionLedgerEntry[]

  @@map("payment_transactions")
  @@schema("payment_schema")
}

model Invoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  bookingId     String   @map("booking_id") @db.Uuid
  subtotal      Decimal  @db.Decimal(10, 2)
  cgstAmount    Decimal  @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount    Decimal  @map("sgst_amount") @db.Decimal(10, 2)
  grandTotal    Decimal  @map("grand_total") @db.Decimal(10, 2)
  pdfVaultUri   String   @map("pdf_vault_uri") @db.VarChar(512)
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz()

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("invoices")
  @@schema("payment_schema")
}

model PaymentIntent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  orderNumber    String   @map("order_number") @db.VarChar(100)
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR") @db.VarChar(10)
  provider       String   @db.VarChar(50)
  clientSecret   String?  @map("client_secret") @db.VarChar(255)
  gatewayOrderId String   @map("gateway_order_id") @db.VarChar(255)
  status         String   @default("CREATED") @db.VarChar(50)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([gatewayOrderId])
  @@map("payment_intents")
  @@schema("payment_schema")
}

model RefundRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId    String    @map("transaction_id") @db.Uuid
  bookingId        String    @map("booking_id") @db.Uuid
  gatewayRefundId  String?   @map("gateway_refund_id") @db.VarChar(255)
  refundAmount     Decimal   @map("refund_amount") @db.Decimal(10, 2)
  retainedFee      Decimal   @map("retained_fee") @db.Decimal(10, 2)
  refundPercentage Int       @map("refund_percentage")
  reason           String    @db.VarChar(500)
  policyTier       String    @map("policy_tier") @db.VarChar(50)
  status           String    @default("INITIATED") @db.VarChar(50)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  booking          Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([transactionId])
  @@map("refund_records")
  @@schema("payment_schema")
}

model TransactionLedgerEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String?  @map("transaction_id") @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  accountType   String   @map("account_type") @db.VarChar(50)
  entryType     String   @map("entry_type") @db.VarChar(10)
  amount        Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(10, 2)
  referenceId   String   @map("reference_id") @db.VarChar(100)
  description   String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([accountType])
  @@map("transaction_ledger_entries")
  @@schema("payment_schema")
}

model IdempotencyRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(128)
  endpoint        String   @db.VarChar(255)
  requestHash     String   @map("request_hash") @db.VarChar(64)
  responsePayload Json     @map("response_payload")
  statusCode      Int      @map("status_code")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("payment_schema")
}

model PaymentGatewayConfig {
