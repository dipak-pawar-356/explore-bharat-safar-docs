      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "BullMQ Active Workers",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ebs_subsystem_up{subsystem=\"workers\"})",
          "legendFormat": "Active Workers"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Node Disk Pressure",
      "type": "stat",
      "targets": [
        {
          "expr": "max(node_filesystem_avail_bytes / node_filesystem_size_bytes) * 100",
          "legendFormat": "Free Disk %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
