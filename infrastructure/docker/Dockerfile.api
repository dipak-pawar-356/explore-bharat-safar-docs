# Explore Bharat Safar — Production apps/api Multi-Stage Distroless Container
# Hardened against CIS Docker Benchmarks (Non-root, minimal attack surface)

# Stage 1: Build Dependencies & Source
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ebs/api build
RUN pnpm prune --prod

# Stage 2: Distroless Minimal Production Runtime
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

COPY --from=builder --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --from=builder --chown=nonroot:nonroot /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nonroot:nonroot /app/apps/api/package.json ./apps/api/package.json

USER nonroot:nonroot
EXPOSE 4000

CMD ["apps/api/dist/main.js"]
