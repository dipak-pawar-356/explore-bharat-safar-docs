# Explore Bharat Safar — Production apps/worker BullMQ Processor Container
# Multi-stage distroless build with non-root security context

# Stage 1: Build Dependencies & Source
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ebs/worker build
RUN pnpm prune --prod

# Stage 2: Distroless Minimal Production Runtime
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --from=builder --chown=nonroot:nonroot /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=nonroot:nonroot /app/apps/worker/package.json ./apps/worker/package.json

USER nonroot:nonroot

CMD ["apps/worker/dist/worker.js"]
