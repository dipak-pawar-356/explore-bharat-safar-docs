{
  "Rules": [
    {
      "ID": "ebs-backup-lifecycle-tiering",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "daily/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 90,
          "StorageClass": "GLACIER"
        },
        {
          "Days": 180,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ],
      "Expiration": {
        "Days": 365
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "ebs-wal-archives-lifecycle",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "wal/"
      },
      "Expiration": {
        "Days": 35
      }
    },
    {
      "ID": "ebs-media-transcoded-lifecycle",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "media/temp/"
      },
      "Expiration": {
        "Days": 14
      }
    }
  ]
}
